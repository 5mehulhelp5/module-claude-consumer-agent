{
    "name": "mage-os/module-ai-shopping-assistant",
    "description": "AI shopping assistant for Hyva and Luma storefronts, on any AI service configured in Mage-OS AI Base.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "mage-os/module-ai-base": "^1.0",
        "ext-intl": "*",
        "ext-json": "*",
        "magento/framework": "*",
        "magento/module-store": "*",
        "magento/module-checkout": "*",
        "magento/module-catalog": "*",
        "magento/module-configurable-product": "*",
        "magento/module-quote": "*",
        "magento/module-customer": "*",
        "magento/module-sales": "*",
        "magento/module-sales-rule": "*",
        "magento/module-cms": "*",
        "magento/module-config": "*",
        "magento/module-offline-shipping": "*",
        "magento/module-search": "*",
        "magento/module-payment": "*",
        "magento/module-shipping": "*"
    },
    "replace": {
        "mage-os/module-claude-consumer-agent": "*"
    },
    "suggest": {
        "magento/module-inventory-sales-api": "Reserved stock aware fulfillment facts when MSI is installed",
        "hyva-themes/magento2-theme-module": "Hyvä storefront templates; Luma based themes need no Hyvä package"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MageOS\\AiShoppingAssistant\\": ""
        }
    }
}
